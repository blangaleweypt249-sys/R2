{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "VS Code: Check C sources",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/vscode_check.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "armclang",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*\\.(?:c|h))\\((\\d+)\\):\\s+(error|warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Keil: Build R2",
            "type": "process",
            "command": "${config:keil.uv4Path}",
            "args": [
                "-b",
                "${workspaceFolder}/MDK-ARM/R2.uvprojx",
                "-j0"
            ],
            "options": {
                "cwd": "${workspaceFolder}/MDK-ARM"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
